# Velavan Properties Attendance - Environment Configuration

# Server Port
PORT=5000

# Timezone (always IST)
TZ=Asia/Kolkata

# Database Driver: 'mysql' or 'sqlite'
DB_DRIVER=mysql

# MySQL Cloud Credentials (e.g. Aiven Free MySQL, TiDB Serverless, or AWS RDS)
# Option A: Connection URL format
MYSQL_URL=mysql://avnadmin:YOUR_PASSWORD@your-mysql-instance.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option B: Individual host parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=velavan_attendance
MYSQL_SSL=true

# Security Settings
ADMIN_DEFAULT_PASSWORD=admin123
